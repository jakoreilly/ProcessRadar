<Window x:Class="ProcessRadar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcessRadar"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="Process Radar" Height="600" Width="1100"
        Background="#0b1120">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SnapshotButton" Content="Snapshot" Width="100" Click="SnapshotButton_Click"/>
            <Button x:Name="LiveButton" Content="Start live trace (admin)" Width="180" Margin="10,0,0,0" Click="LiveButton_Click"/>
            <TextBlock x:Name="CountText" Foreground="#94a3b8" VerticalAlignment="Center" Margin="16,0,0,0" Text="0 processes"/>
            <TextBlock x:Name="GraphText" Foreground="#5eead4" VerticalAlignment="Center" Margin="16,0,0,0" Text="0 nodes"/>
            <TextBlock x:Name="InjectionText" Foreground="#f87171" VerticalAlignment="Center" Margin="16,0,0,0" Text="0 injection signals"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="220" TextChanged="FilterBox_TextChanged"/>
            <Button x:Name="FreezeButton" Content="Freeze frame" Width="110" Margin="16,0,0,0" Click="FreezeButton_Click"/>

            <TextBlock Text="Zoom:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <Button x:Name="ZoomOutButton" Content="-" Width="28" Click="ZoomOutButton_Click"
                    ToolTip="Zoom out (mouse wheel down over the diagram)"/>
            <Button x:Name="ZoomInButton" Content="+" Width="28" Margin="4,0,0,0" Click="ZoomInButton_Click"
                    ToolTip="Zoom in (mouse wheel up over the diagram)"/>
            <TextBlock x:Name="ZoomText" Text="100%" Foreground="#5eead4" VerticalAlignment="Center"
                       Width="48" TextAlignment="Center" FontFamily="Consolas"/>
            <Button x:Name="ResetViewButton" Content="Reset view" Width="90" Click="ResetViewButton_Click"
                    ToolTip="Back to 100% and centred (double-click the diagram does the same)"/>
            <TextBlock Text="drag to pan" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>

            <Button x:Name="ExportButton" Content="Export logs" Width="90" Margin="20,0,0,0" Click="ExportButton_Click"
                    ToolTip="Save the current process table and the anomaly history to a CSV file. Like the debug log, it records executable paths - review before sharing."/>

            <ToggleButton x:Name="DebugToggle" Content="Debug" Width="70" Margin="20,0,0,0"
                          IsChecked="False" Checked="DebugToggle_Changed" Unchecked="DebugToggle_Changed"
                          ToolTip="Frame timing / layout / capture diagnostics - on-canvas HUD plus a log file under LocalAppData/ProcessRadar/logs. Off by default: the log records executable and module paths."/>
            <TextBlock x:Name="DebugPathText" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#1e293b" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <skia:SKElement x:Name="GraphCanvas" PaintSurface="GraphCanvas_PaintSurface" SizeChanged="GraphCanvas_SizeChanged"
                                    MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                                    MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                                    MouseMove="GraphCanvas_MouseMove"
                                    MouseWheel="GraphCanvas_MouseWheel"
                                    ClipToBounds="True"/>
                    <Border x:Name="InspectorPanel" Visibility="Collapsed" Background="#0b1120" Opacity="0.92"
                            BorderBrush="#5eead4" BorderThickness="1" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10" MinWidth="260" MaxWidth="360">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="InspectorTitle" Foreground="#5eead4" FontWeight="Bold" FontFamily="Consolas"/>
                                <Button x:Name="InspectorCloseButton" Content="x" Width="20" Height="20" Padding="0"
                                        HorizontalAlignment="Right" Click="InspectorCloseButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="InspectorPath" Foreground="#e8ecf5" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InspectorTimes" Foreground="#e8ecf5" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="InspectorModules" Foreground="#e8ecf5" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="InspectorAnomaly" Foreground="#f87171" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="InspectorHash" Foreground="#94a3b8" FontFamily="Consolas" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InspectorSigner" Foreground="#94a3b8" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InspectorCommandLine" Foreground="#94a3b8" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="ProcessList" Grid.Row="0" FontFamily="Consolas" FontSize="10" Background="#111a2e" Foreground="#e8ecf5" BorderThickness="0"/>
                <TextBlock Grid.Row="1" Text="Anomalies" Foreground="#f87171" FontWeight="Bold" Margin="4,8,0,4"/>
                <ListBox x:Name="AnomalyList" Grid.Row="2" FontFamily="Consolas" FontSize="10" Background="#1a1017" Foreground="#fecaca" BorderThickness="1" BorderBrush="#7f1d1d"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
